     assert_eq!(
-        aper::decode::<S2>(&[0x90, 0xff, 0xc0]).unwrap(),
+        aper::decode::<S2>(&[0x9f, 0xfc]).unwrap(),
         S2(SequenceOf::from(vec![true; 10]))
     );
 }
