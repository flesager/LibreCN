# LibreCN's settings for docker compose: save this file as .env next to
# compose.yaml. Every line is optional.
#
# Once, on the host (as root): IP forwarding for the UEs' NAT, kept across
# reboots. SCTP (N2) is loaded by the kernel when needed; if the AMF says
# SCTP is missing: modprobe sctp && echo sctp > /etc/modules-load.d/sctp.conf
#   sysctl -w net.ipv4.ip_forward=1 && echo net.ipv4.ip_forward=1 > /etc/sysctl.d/99-librecn.conf

# The image: a version (0.1.0) or latest.
LIBRECN_VERSION=latest

# The address gNBs reach for N2 (SCTP 38412) and N3 (GTP-U 2152). Empty:
# the host's main address (the one its default route leaves from).
LIBRECN_ADDRESS=

# The network: PLMN (as on the gNB and the SIMs), slice (SD optional), DNN
# and the UEs' addresses (the first one is the core's side).
LIBRECN_MCC=001
LIBRECN_MNC=01
LIBRECN_SST=1
LIBRECN_SD=
LIBRECN_DNN=internet
LIBRECN_UE_POOL=10.45.0.0/16

# The UEs reach the outside through the host (NAT): yes or no.
LIBRECN_NAT=yes

# The GUI and web API (no authentication yet: keep it on 127.0.0.1, or
# open it with 0.0.0.0:8080 on a trusted network only). Subscribers (their
# SIMs' IMSI, K, OPc) are added there, under Provisioning, and kept.
LIBRECN_GUI=127.0.0.1:8080

# Logs (docker compose logs): vip, fatal, error, info, debug.
LIBRECN_LOG=info
