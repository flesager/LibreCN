 {
 }
 
+UdpServer::UdpServer(const std::vector<std::string> &addresses, uint16_t port) : sockets{}
+{
+    for (auto &address : addresses)
+        sockets.push_back(Socket::CreateAndBindUdp({address, port}));
+}
+
+int UdpServer::Receive(uint8_t *buffer, size_t bufferSize, int timeoutMs, InetAddress &outPeerAddress,
+                       size_t &outIndex) const
+{
+    auto socket = Socket::Select(sockets, {}, timeoutMs);
+    if (!socket.hasFd())
+        return 0;
+    for (size_t i = 0; i < sockets.size(); i++)
+        if (sockets[i].getFd() == socket.getFd())
+            outIndex = i;
+    return socket.receive(buffer, bufferSize, timeoutMs, outPeerAddress);
+}
+
+void UdpServer::SendFrom(size_t index, const InetAddress &address, const uint8_t *buffer, size_t bufferSize) const
+{
+    sockets.at(index).send(address, buffer, bufferSize);
+}
